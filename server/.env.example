# Google Cloud Console > API 및 서비스 > 사용자 인증 정보 > OAuth 2.0 클라이언트 ID (웹 애플리케이션)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# 비워두면 모든 구글 계정 허용. 회사 도메인만 허용하려면 JSON 배열로 지정
# ALLOWED_EMAIL_DOMAINS=["example.com"]

# 반드시 변경: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=1440
# WEB_REFRESH_TOKEN_TTL_DAYS=14

# 저장소 백엔드: sqlite (기본, WAL + FTS5 + 멀티 워커 지원, 기존 data/*.json 자동 이전) | json
DB_BACKEND=sqlite
# DB 및 첨부파일 저장 위치 (server/ 기준 상대경로)
DATA_DIR=data

CORS_ORIGINS=["http://localhost:5174"]

# MCP 서버·OAuth — 외부에서 접속하는 주소 (운영은 https). MCP 주소 = <PUBLIC_URL>/mcp
PUBLIC_URL=http://localhost:8000
# OAuth 동의 화면이 있는 웹 앱 주소
APP_URL=http://localhost:5174
# MCP_ACCESS_TOKEN_TTL_SEC=3600
# MCP_REFRESH_TOKEN_TTL_DAYS=30
# OAUTH_DCR_MAX_CLIENTS=500
# OAUTH_DCR_RATE_LIMIT_PER_MIN=30

# 초대 메일 발송용 SMTP (비워두면 메일 발송만 건너뜀)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASSWORD=app-password
# SMTP_FROM=MightyWork <noreply@example.com>
# SMTP_USE_TLS=true
