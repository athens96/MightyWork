# Google Cloud Console > API 및 서비스 > 사용자 인증 정보 > OAuth 2.0 클라이언트 ID (웹 애플리케이션)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# 비워두면 모든 구글 계정 허용. 회사 도메인만 허용하려면 JSON 배열로 지정
# ALLOWED_EMAIL_DOMAINS=["example.com"]

# 반드시 변경: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=1440

# 파일 DB 저장 위치 (server/ 기준 상대경로)
DATA_DIR=data

CORS_ORIGINS=["http://localhost:5174"]

# MCP 서버·OAuth — 외부에서 접속하는 주소 (운영은 https). MCP 주소 = <PUBLIC_URL>/mcp
PUBLIC_URL=http://localhost:8000
# OAuth 동의 화면이 있는 웹 앱 주소
APP_URL=http://localhost:5174
# MCP_ACCESS_TOKEN_TTL_SEC=3600
# MCP_REFRESH_TOKEN_TTL_DAYS=30
