# /etc/systemd/system/mighty-work-api.service
[Unit]
Description=MightyWork API (Rust axum + MCP)
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/opt/mighty-work/server
EnvironmentFile=/opt/mighty-work/server/.env
# kordoc(node)·pandoc 을 찾도록 기존 PATH 유지
Environment=PATH=/opt/mighty-work/server/.venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOST=127.0.0.1
Environment=PORT=8000
Environment=RUST_LOG=info
# 단일 Rust 바이너리가 127.0.0.1:8000 에서 nginx 뒤에 둔다 (SQLite WAL + FTS5 + SSE + MCP)
ExecStart=/opt/mighty-work/server-rs/mightywork-server
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
